		"@wordpress/components": "^39.0.0",
		"@wordpress/compose": "^8.6.0",
		"@wordpress/core-data": "^7.53.0",
		"@wordpress/data": "^10.53.0",
		"@wordpress/e2e-test-utils-playwright": "^1.53.0",
