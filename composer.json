{
	"name": "swissspidy/public-collaboration",
	"description": "Share a link that lets someone edit one post with you for fifteen minutes. No account, no login, no invitation email.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Pascal Birchler",
			"homepage": "https://pascalbirchler.com"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^7.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"format": "phpcbf --report-summary --report-source .",
		"lint": "phpcs --report-summary --report-source .",
		"phpstan": "phpstan analyse --memory-limit=2G",
		"test": "phpunit"
	}
}